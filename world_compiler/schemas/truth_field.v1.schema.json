{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobrain.local/schemas/truth_field.v1.schema.json",
  "title": "AeroBrain Truth Field v1",
  "type": "object",
  "required": ["version", "calibration_id", "sample_count", "classes", "legend", "coverage_pct", "samples"],
  "properties": {
    "version": {"const": 1},
    "calibration_id": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 0},
    "classes": {
      "type": "array",
      "items": {"enum": ["OBSERVED_MULTI_VIEW", "OBSERVED_WEAK", "GEOMETRICALLY_INFERRED", "GENERATED_CONSTRAINED", "UNKNOWN"]},
      "uniqueItems": true
    },
    "legend": {"type": "object"},
    "coverage_pct": {"type": "object"},
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "confidence", "source_camera_ids", "method"],
        "properties": {
          "class": {"enum": ["OBSERVED_MULTI_VIEW", "OBSERVED_WEAK", "GEOMETRICALLY_INFERRED", "GENERATED_CONSTRAINED", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_camera_ids": {"type": "array", "items": {"type": "string"}},
          "method": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
